# Copia este archivo a `.env` y completa con los datos de tu proyecto de Supabase.
# Los encuentras en: Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Opcional. Solo si despliegas en un dominio distinto al de desarrollo:
# define a dónde debe volver el enlace mágico del correo.
# VITE_APP_URL=https://dadiva.app
