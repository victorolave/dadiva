# Copia este archivo a `.env` y completa con los datos de tu proyecto.
#
# Dónde: Supabase Dashboard → Settings → API Keys → pestaña de llaves
#        publishable / secret.
#
# Copia la PUBLISHABLE key (sb_publishable_...), NO la legacy `anon`:
# Supabase deprecia `anon` y `service_role` a finales de 2026.
#
# NUNCA pongas aquí la secret key (sb_secret_...). Todo lo que lleva el
# prefijo VITE_ termina dentro del bundle que descarga el navegador.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Si tu proyecto todavía usa la llave legacy, esta también funciona:
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Opcional. Solo si despliegas en un dominio distinto al de desarrollo:
# define a dónde debe volver el enlace mágico del correo.
# VITE_APP_URL=https://dadiva.app
